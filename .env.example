APP_NAME="FORCE X Tracking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tracking_forcex
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo. En local "log" escribe los correos en storage/logs/laravel.log.
# En el hosting (cuenta SMTP de cPanel), por ejemplo:
#   MAIL_MAILER=smtp
#   MAIL_HOST=mail.tudominio.com
#   MAIL_PORT=465
#   MAIL_SCHEME=smtps
#   MAIL_USERNAME=tracking@tudominio.com
#   MAIL_PASSWORD=********
#   MAIL_FROM_ADDRESS="tracking@tudominio.com"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Correos automaticos (eventos A, B, C, notas y alertas diarias).
# Requieren el cron de cPanel: * * * * * cd /ruta/app && php artisan schedule:run
FORCEX_NOTIFICATIONS=true
FORCEX_DAILY_ALERTS_AT=07:00
# Los umbrales de las alertas criticas (5 dias / 48 h / 24 h) se editan en Configuracion.
APP_TIMEZONE=America/Lima

# WhatsApp sin costo (enlace wa.me): codigo de pais para celulares escritos sin "+".
FORCEX_WHATSAPP_COUNTRY_CODE=51

# Cotizaciones: IGV de las lineas afectas y dias que dura el enlace del PDF enviado por WhatsApp.
FORCEX_IGV_RATE=0.18
FORCEX_QUOTATION_LINK_DAYS=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
